{
  "id": "frappe-federated",
  "name": "Frappe Federated",
  "description": "Session-aware, rights-aware bridge from OpenClaw into a colocated Frappe site.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "site": {
        "type": "string"
      },
      "benchPath": {
        "type": "string"
      },
      "pythonPath": {
        "type": "string"
      },
      "bridgeModule": {
        "type": "string"
      },
      "bootUser": {
        "type": "string"
      }
    },
    "required": [
      "site",
      "benchPath",
      "pythonPath"
    ]
  }
}
